	"item": [
		{
			"name": "1. Valid Date (29/02/2024)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code phải là 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Kết quả isValid phải là TRUE\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.isValid).to.eql(true);",
							"});",
							"",
							"pm.test(\"Thông báo phải trả về chính xác\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.eql(\"29/02/2024 is correct date time!\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/v1/check?day=29&month=2&year=2024",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"v1",
						"check"
					],
					"query": [
						{
							"key": "day",
							"value": "29"
						},
						{
							"key": "month",
							"value": "2"
						},
						{
							"key": "year",
							"value": "2024"
						}
					]
				}
			},
			"response": []
		},
